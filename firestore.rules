rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Screens validation helper
    function isValidScreen(data) {
      return true;
    }

    // Products validation helper
    function isValidProduct(data) {
      return true;
    }

    // Custom Images validation helper
    function isValidCustomImage(data) {
      return true;
    }

    // Clients validation helper
    function isValidClient(data) {
      return true;
    }

    // Clients collection
    match /clients/{clientId} {
      allow get, list: if true;
      allow create: if isValidId(clientId) && isValidClient(incoming());
      allow update: if isValidId(clientId) && isValidClient(incoming());
      allow delete: if true;
    }

    // Screens collection
    match /screens/{screenId} {
      allow get, list: if true;
      allow create: if isValidId(screenId) && isValidScreen(incoming());
      allow update: if isValidId(screenId) && isValidScreen(incoming());
      allow delete: if true;
    }

    // Products collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if true;
    }

    // Custom Images collection
    match /custom_images/{imageId} {
      allow get, list: if true;
      allow create: if isValidId(imageId) && isValidCustomImage(incoming());
      allow update: if isValidId(imageId) && isValidCustomImage(incoming());
      allow delete: if true;
    }
  }
}
