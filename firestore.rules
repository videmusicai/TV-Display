rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Screens validation helper
    function isValidScreen(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && (data.location == null || (data.location is string && data.location.size() <= 200))
        && (data.currentImage == null || (data.currentImage is string && data.currentImage.size() <= 10485760))
        && (data.lastSync == null || (data.lastSync is string && data.lastSync.size() <= 200))
        && (data.aspectRatio == null || (data.aspectRatio is string && data.aspectRatio.size() <= 20))
        && (data.status == null || (data.status is string && data.status.size() <= 20))
        && (data.overlayPrices == null || data.overlayPrices is bool)
        && (data.selectedCategory == null || (data.selectedCategory is string && data.selectedCategory.size() <= 100))
        && (data.clientId == null || (data.clientId is string && data.clientId.size() <= 128))
        && (data.displayMode == null || (data.displayMode is string && data.displayMode.size() <= 20))
        && (data.shortCode == null || (data.shortCode is string && data.shortCode.size() <= 50))
        && (data.playlist == null || data.playlist is list);
    }

    // Products validation helper
    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && (data.category == null || (data.category is string && data.category.size() <= 100))
        && (data.available == null || data.available is bool)
        && (data.clientId == null || (data.clientId is string && data.clientId.size() <= 128));
    }

    // Custom Images validation helper
    function isValidCustomImage(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.base64 is string && data.base64.size() <= 10485760
        && (data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 200))
        && (data.clientId == null || (data.clientId is string && data.clientId.size() <= 128));
    }

    // Clients validation helper
    function isValidClient(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 200
        && data.ownerEmail is string && data.ownerEmail.size() <= 200
        && data.expirationDate is string && data.expirationDate.size() <= 200
        && (data.status == null || (data.status is string && data.status.size() <= 50))
        && (data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 200))
        && (data.contactPhone == null || (data.contactPhone is string && data.contactPhone.size() <= 50))
        && (data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (data.plan == null || (data.plan is string && data.plan.size() <= 50))
        && (data.monthlyFee == null || data.monthlyFee is number);
    }

    // Clients collection
    match /clients/{clientId} {
      allow get, list: if true;
      allow create: if isValidId(clientId) && isValidClient(incoming());
      allow update: if isValidId(clientId) && isValidClient(incoming());
      allow delete: if true;
    }

    // Screens collection
    match /screens/{screenId} {
      allow get, list: if true;
      allow create: if isValidId(screenId) && isValidScreen(incoming());
      allow update: if isValidId(screenId) && isValidScreen(incoming());
      allow delete: if true;
    }

    // Products collection
    match /products/{productId} {
      allow get, list: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if true;
    }

    // Custom Images collection
    match /custom_images/{imageId} {
      allow get, list: if true;
      allow create: if isValidId(imageId) && isValidCustomImage(incoming());
      allow update: if isValidId(imageId) && isValidCustomImage(incoming());
      allow delete: if true;
    }
  }
}
