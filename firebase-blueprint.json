{
  "entities": {
    "Client": {
      "title": "Client",
      "description": "Represents a tenant or merchant client subscribing to the display system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "expirationDate": { "type": "string" },
        "monthlyFee": { "type": "number" },
        "status": { "type": "string" },
        "contactPhone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "ownerEmail", "expirationDate"]
    },
    "Screen": {
      "title": "Screen",
      "description": "Represents a physical TV screen display configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "currentImage": { "type": "string" },
        "lastSync": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "status": { "type": "string" },
        "overlayPrices": { "type": "boolean" },
        "selectedCategory": { "type": "string" },
        "clientId": { "type": "string" },
        "displayMode": { "type": "string" },
        "playlist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "image": { "type": "string" },
              "duration": { "type": "number" },
              "enabled": { "type": "boolean" }
            },
            "required": ["id", "image", "duration", "enabled"]
          }
        }
      },
      "required": ["id", "name"]
    },
    "Product": {
      "title": "Product",
      "description": "Bakery menu items and prices in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "available": { "type": "boolean" },
        "clientId": { "type": "string" }
      },
      "required": ["id", "name", "price"]
    },
    "CustomImage": {
      "title": "CustomImage",
      "description": "Custom uploaded promotion images stored in the database",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "base64": { "type": "string" },
        "createdAt": { "type": "string" },
        "clientId": { "type": "string" }
      },
      "required": ["id", "name", "base64"]
    }
  },
  "firestore": {
    "clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of clients subscribing to the platform"
    },
    "screens/{screenId}": {
      "schema": "Screen",
      "description": "Collection of screens and their active media assets"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of products for pricing catalog"
    },
    "custom_images/{imageId}": {
      "schema": "CustomImage",
      "description": "Collection of user-uploaded promotional images for screens"
    }
  }
}
